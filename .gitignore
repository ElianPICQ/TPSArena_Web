node_modules/
.env
dist/
*.log
.DS_Store

# Builds du jeu et captures : copiés à la main sur l'hôte, jamais versionnés.
releases/*/*
!releases/*/.gitkeep
screenshots/*
!screenshots/.gitkeep

# Certificat HTTPS et clé (scripts/certificat.sh) : propres à chaque machine, jamais versionnés.
certs/*
!certs/.gitkeep
