# Alias mDNS tpsarena.local -> adresse IP de cette machine.
# Installation : voir le README (section « Nom tpsarena.local »).
[Unit]
Description=Alias mDNS tpsarena.local (Avahi)
Requires=avahi-daemon.service
After=avahi-daemon.service network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/tpsarena-alias.sh tpsarena.local
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
